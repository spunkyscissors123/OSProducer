# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used ONLY by the Stripe webhook / checkout to write subscription rows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI (server-only) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
# Set to "false" to disable all AI calls instantly (cost kill-switch).
AI_ENABLED=true

# ── Stripe (TEST MODE ONLY during development) ───────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
# Live keys (sk_live_) are refused unless this is explicitly "true".
ALLOW_LIVE_BILLING=false

# ── Display pricing (cents). Keep in sync with your Stripe prices. ───
NEXT_PUBLIC_PRICE_STARTER_CENTS=2900
NEXT_PUBLIC_PRICE_PRO_CENTS=4900
